# Version control and local tooling
.git
.github
.idea
.vscode
.fleet
.DS_Store
Thumbs.db

# Environment files: keep only the safe example template
.env
.env.*
!.env.example
**/.env
**/.env.*
!**/.env.example

# Installed dependencies
/vendor
/node_modules
/dashboard/node_modules
**/node_modules
**/vendor

# Generated frontend assets
/public/build
/public/hot
/dashboard/dist
/dashboard/coverage

# Runtime data, caches, and logs
/storage/logs
/storage/framework/cache
/storage/framework/sessions
/storage/framework/views
/storage/framework/testing
/bootstrap/cache/*.php
*.log

# Test and analysis output
.phpunit.cache
.phpunit.result.cache
coverage

# Private service credentials
/storage/app/firebase_credentials.json
**/*firebase*credentials*.json
