{
	"info": {
		"_postman_id": "sindbad-api-collection",
		"name": "Sindbad Oprition System",
		"description": "Postman Collection for Sindbad Mobile Application",
		"schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
	},
	"item": [
		{
			"name": "Auth",
			"item": [
				{
					"name": "Validate Phone",
					"request": {
						"method": "POST",
						"header": [],
						"body": {
							"mode": "raw",
							"raw": "{\n    \"phone\": \"96812345678\"\n}",
							"options": {
								"raw": {
									"language": "json"
								}
							}
						},
						"url": {
							"raw": "{{base_url}}/auth/validate-phone",
							"host": ["{{base_url}}"],
							"path": ["auth", "validate-phone"]
						}
					}
				},
				{
					"name": "Login",
					"request": {
						"method": "POST",
						"header": [],
						"body": {
							"mode": "raw",
							"raw": "{\n    \"phone\": \"96812345678\",\n    \"password\": \"password\",\n    \"device_name\": \"Postman\"\n}",
							"options": {
								"raw": {
									"language": "json"
								}
							}
						},
						"url": {
							"raw": "{{base_url}}/auth/login",
							"host": ["{{base_url}}"],
							"path": ["auth", "login"]
						}
					}
				},
				{
					"name": "Get Profile",
					"request": {
						"method": "GET",
						"header": [
							{
								"key": "Authorization",
								"value": "Bearer {{token}}",
								"type": "text"
							}
						],
						"url": {
							"raw": "{{base_url}}/profile",
							"host": ["{{base_url}}"],
							"path": ["profile"]
						}
					}
				}
			]
		},
		{
			"name": "Service Requests",
			"item": [
				{
					"name": "List All Requests",
					"request": {
						"method": "GET",
						"header": [
							{
								"key": "Authorization",
								"value": "Bearer {{token}}",
								"type": "text"
							}
						],
						"url": {
							"raw": "{{base_url}}/requests",
							"host": ["{{base_url}}"],
							"path": ["requests"]
						}
					}
				},
				{
					"name": "Create Request",
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Authorization",
								"value": "Bearer {{token}}",
								"type": "text"
							}
						],
						"body": {
							"mode": "formdata",
							"formdata": [
								{ "key": "service_type", "value": "installation", "type": "text" },
								{ "key": "description", "value": "Need AC installation", "type": "text" },
								{ "key": "address", "value": "Muscat, Seeb", "type": "text" },
								{ "key": "scheduled_at", "value": "2025-02-20 10:00:00", "type": "text" }
							]
						},
						"url": {
							"raw": "{{base_url}}/requests",
							"host": ["{{base_url}}"],
							"path": ["requests"]
						}
					}
				},
				{
					"name": "Rate Request",
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Authorization",
								"value": "Bearer {{token}}",
								"type": "text"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n    \"rating\": 5,\n    \"review_comment\": \"Excellent!\"\n}",
							"options": {
								"raw": { "language": "json" }
							}
						},
						"url": {
							"raw": "{{base_url}}/requests/1/rate",
							"host": ["{{base_url}}"],
							"path": ["requests", "1", "rate"]
						}
					}
				}
			]
		},
		{
			"name": "Technician",
			"item": [
				{
					"name": "Update Status",
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Authorization",
								"value": "Bearer {{token}}",
								"type": "text"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n    \"status\": \"on_way\",\n    \"send_notification\": true\n}",
							"options": { "raw": { "language": "json" } }
						},
						"url": {
							"raw": "{{base_url}}/requests/1/status",
							"host": ["{{base_url}}"],
							"path": ["requests", "1", "status"]
						}
					}
				}
			]
		}
	],
	"variable": [
		{
			"key": "base_url",
			"value": "http://localhost:8000/api"
		},
		{
			"key": "token",
			"value": ""
		}
	]
}
